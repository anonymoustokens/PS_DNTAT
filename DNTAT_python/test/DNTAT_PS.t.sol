pragma solidity ^0.8.17;

import "forge-std/Test.sol";
import {DNTAT_PS} from "../src/DNTAT_PS.sol";
import {BLS} from "../src/utils/BLS.sol";

contract DNTAT_PSTest is Test {
    BLS public bls;
    DNTAT_PS public dntat_ps;

    function setUp() public {
        bls = new BLS();
        dntat_ps = new DNTAT_PS(bls);
    }

    function testVerify() public {
        uint256[2] memory sigma = [3648986387863044733070015919922700165063524856543459519045252992392419803223, 16552358327185677392121176240266096568084094502830800330530363858014214382204];

        uint256[2] memory h = [17776136113905742841899769241292550960305059193886841341961104239905432971545, 21769251789511738929086882059114470751924477534723216238472794056613054816203];

        uint256[4] memory sigma_bar = [4956648069010261654594303625873557623818409710556386688565951648586964999728, 1336504844187537553209354049210623793856252085978905794595875133095645357277, 20915252622871436202066792357545910885332287757401764461766208127277349137607, 19214802817498680258190333230854784044047521773685683452220088798686133378232];

        assertTrue(dntat_ps.verify(sigma_bar, sigma, h));
        assertTrue(dntat_ps.usedCredentials(sha256(abi.encode(h,sigma))));
    }
}
